# Database Configuration (PostgreSQL only)
DATABASE_URL="postgresql://username:password@localhost:5432/kodein?schema=public"
SHADOW_DATABASE_URL=""

# NextAuth / Auth.js Configuration
# AUTH_URL must match the canonical base URL of your deployment
AUTH_URL="http://localhost:3000"
AUTH_SECRET="use-a-strong-random-32-byte-hex-string-for-auth-secret"

# OAuth Providers (Optional pairs - set both in a pair, or neither)
AUTH_GOOGLE_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Resend Email Configuration (Required in production)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
CONTACT_TO_EMAIL=""

# Code Execution Backend Configuration (Required in production)
# PISTON_BASE_URL must point to an HTTPS, authorized or self-hosted Piston-compatible endpoint in production
PISTON_BASE_URL=""
# PISTON_AUTH_TOKEN is required if using an authorized public Piston endpoint
PISTON_AUTH_TOKEN=""
